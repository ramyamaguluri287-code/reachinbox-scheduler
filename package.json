{
  "name": "reachinbox-fullstack-scheduler-monorepo",
  "version": "1.0.0",
  "description": "Production-Grade Full-Stack Email Job Scheduler Monorepo for ReachInbox",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "prisma:push": "npx --prefix backend prisma db push",
    "prisma:studio": "npm --prefix backend run prisma:studio",
    "seed": "npx --prefix backend tsx prisma/seed.ts",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test:constraints": "npm --prefix backend run test:constraints"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
